# microCMS（サイトビルド時の読み取り）
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# microCMS 書き込み用（任意）
# scripts/push-pricing-to-cms.mjs で料金・プラン内容を同期するときに使います。
# 未設定の場合は MICROCMS_API_KEY を使います（書き込み権限が必要）。
# MICROCMS_WRITE_API_KEY=your-write-api-key

# Cloudflare Pages でプレビューURLを使う場合（任意）
# SITE_URL=https://your-branch.amaterasu.pages.dev

# Formspree の送信先は microCMS の contact-settings > formspreeEndpoint で管理します
